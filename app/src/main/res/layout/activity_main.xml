<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:orientation="vertical" android:padding="22dp"
 android:layout_width="match_parent" android:layout_height="match_parent">

 <TextView android:text="TSK Car Media v1.8.1"
  android:textSize="28sp" android:textStyle="bold"
  android:layout_width="match_parent" android:layout_height="wrap_content"/>

 <TextView android:text="S25 → Wi-Fi → Raspberry Pi → TROFEO"
  android:textSize="16sp" android:paddingBottom="14dp"
  android:layout_width="match_parent" android:layout_height="wrap_content"/>

 <TextView android:text="Raspberry Pi IP"
  android:textSize="15sp"
  android:layout_width="match_parent" android:layout_height="wrap_content"/>

 <EditText android:id="@+id/ip" android:text="172.19.95.46"
  android:inputType="text"
  android:singleLine="true"
  android:layout_width="match_parent" android:layout_height="wrap_content"/>

 <Button android:id="@+id/start" android:text="START → PI"
  android:layout_width="match_parent" android:layout_height="68dp"/>

 <Button android:id="@+id/stop" android:text="STOP"
  android:layout_width="match_parent" android:layout_height="68dp"/>

 <TextView android:id="@+id/status"
  android:text="Ready • 1280×480 • JPEG Q50 • 25 FPS • UDP 8766"
  android:textSize="18sp" android:paddingTop="14dp"
  android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout>